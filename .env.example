# Copy to .env (git-ignored). Read by `pnpm dev`, `pnpm refresh` and `pnpm trigger`.
# Production secrets are separate: `pnpm wrangler secret put GH_TOKEN` / `RUN_KEY`.

# Fine-grained PAT: only shreesharma07/shreesharma07, Contents read and write
GH_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxx
# openssl rand -hex 32; must match the Worker's RUN_KEY secret for `pnpm trigger`
RUN_KEY=replace-with-output-of-openssl-rand-hex-32
# The deployed Worker, for `pnpm trigger`
WORKER_URL=https://gh-profile-worker.<your-subdomain>.workers.dev

# false: local runs commit to the real profile repo, exactly like production.
# Set true (or use `pnpm refresh:dry` / `pnpm trigger:dry`) to only compute.
DRY_RUN=false
